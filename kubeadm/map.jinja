{#- kubeadm pillar map: defaults -> cluster -> selected role -> node. #}
{%- set defaults_data = salt['slsutil.renderer'](
      'salt://kubeadm/defaults.yaml',
      default_renderer='yaml'
    ) %}
{%- set pillar_data = salt['pillar.get']('kubeadm', {}) %}
{%- set node_data = pillar_data.get('node', {}) %}
{%- set role_name = node_data.get('role', defaults_data.kubeadm.node.role) %}
{%- set role_data = pillar_data.get('roles', {}).get(role_name, {}) %}

{%- set role_violations = salt['kubeadm_util.check_denylist'](
      role_data,
      defaults_data.denylist
    ) %}
{%- set node_violations = salt['kubeadm_util.check_denylist'](
      node_data,
      defaults_data.denylist
    ) %}
{%- set violations = role_violations + node_violations %}
{%- if violations %}
  {%- do raise('Forbidden kubeadm role/node pillar paths: ' ~ violations) %}
{%- endif %}

{%- set cluster_data = dict(pillar_data) %}
{%- do cluster_data.pop('roles', None) %}
{%- do cluster_data.pop('node', None) %}
{%- set kubeadm = salt['kubeadm_util.merge_layers'](
      defaults_data.kubeadm,
      cluster_data,
      {'node': role_data},
      {'node': node_data}
    ) %}
